{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finguard.io/contracts/audit/execution-outcome.schema.json",
  "title": "ExecutionOutcome",
  "description": "정책 결정과 시스템 실행 결과를 분리한 최종 실행 결과",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "systemOutcome",
    "downstreamReached",
    "responseReleased",
    "completedAt"
  ],
  "properties": {
    "requestId": { "$ref": "#/$defs/nonEmptyIdentifier" },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "BLOCK", "APPROVAL", "MASK"]
    },
    "systemOutcome": {
      "type": "string",
      "enum": ["COMPLETED", "ERROR"]
    },
    "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
    "downstreamReached": { "type": "boolean" },
    "responseReleased": { "type": "boolean" },
    "success": { "type": "boolean" },
    "recordsRead": {
      "type": "integer",
      "minimum": 0
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0
    },
    "errorLocation": { "$ref": "#/$defs/upperSnakeCase" },
    "severity": { "$ref": "#/$defs/severity" },
    "riskFlagged": { "type": "boolean" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "decisionStage": {
      "$comment": "Where the final decision was made: REQUEST (before the call, the only stage before stage 5) or RESPONSE (after the call, on the scanned response). Absent means REQUEST.",
      "type": "string",
      "enum": ["REQUEST", "RESPONSE"]
    },
    "responseScan": { "$ref": "#/$defs/responseScan" },
    "policyInput": {
      "$comment": "OPA inputs the Core audit row does not already hold. Only when a policy decision was reached (docs/04 §11). null means the same as absent.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["behaviorRiskLevel", "behaviorAnomalyDetected", "hardRequestLimitExceeded"],
      "properties": {
        "behaviorRiskLevel": { "type": "string", "enum": ["LOW", "ALERT", "CRITICAL"] },
        "behaviorAnomalyDetected": { "type": "boolean" },
        "hardRequestLimitExceeded": { "type": "boolean" },
        "approvalGranted": {
          "$comment": "OPA input approval.granted (loan-review-policy-4). Optional so a gateway that does not send it yet stays valid; absent means the same as false.",
          "type": "boolean"
        }
      }
    }
  },
  "dependentRequired": {
    "severity": ["riskFlagged"],
    "riskFlagged": ["severity"]
  },
  "allOf": [
    {
      "$comment": "Stage 5 state table (docs/04 §11.1). APPROVAL is always a request-stage decision.",
      "if": {
        "properties": { "decision": { "const": "APPROVAL" } },
        "required": ["decision"]
      },
      "then": { "not": { "properties": { "decisionStage": { "const": "RESPONSE" } }, "required": ["decisionStage"] } }
    },
    {
      "$comment": "A response-stage outcome reached the policy and the downstream: it always has a decision and reached the tool.",
      "if": {
        "properties": { "decisionStage": { "const": "RESPONSE" } },
        "required": ["decisionStage"]
      },
      "then": {
        "required": ["decision", "downstreamReached"],
        "properties": { "downstreamReached": { "const": true } }
      }
    },
    {
      "$comment": "MASK released a masked response: only after the call, only completed, always with reasons and scan evidence.",
      "if": {
        "properties": { "decision": { "const": "MASK" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["decisionStage", "reasonCodes", "responseScan"],
        "properties": {
          "decisionStage": { "const": "RESPONSE" },
          "systemOutcome": { "const": "COMPLETED" },
          "reasonCodes": { "$ref": "#/$defs/nonEmptyReasonCodes" }
        }
      }
    },
    {
      "$comment": "A response-stage BLOCK ran the tool and withheld the result: reached, not released, failed for the caller, measured, nothing read out.",
      "if": {
        "properties": {
          "decision": { "const": "BLOCK" },
          "decisionStage": { "const": "RESPONSE" }
        },
        "required": ["decision", "decisionStage"]
      },
      "then": {
        "required": ["reasonCodes", "success", "latencyMs", "responseReleased"],
        "properties": {
          "systemOutcome": { "const": "COMPLETED" },
          "reasonCodes": { "$ref": "#/$defs/nonEmptyReasonCodes" },
          "responseReleased": { "const": false },
          "success": { "const": false }
        },
        "not": { "required": ["recordsRead"] }
      }
    },
    {
      "$comment": "Scan evidence exists exactly when the response stage completed. A failed scan has no counts to trust, so none are recorded.",
      "if": {
        "properties": {
          "decisionStage": { "const": "RESPONSE" },
          "systemOutcome": { "const": "COMPLETED" }
        },
        "required": ["decisionStage", "systemOutcome"]
      },
      "then": { "required": ["responseScan", "latencyMs"] },
      "else": { "not": { "required": ["responseScan"] } }
    },
    {
      "$comment": "A released response-stage result read exactly one document.",
      "if": {
        "properties": {
          "decision": { "enum": ["ALLOW", "MASK"] },
          "decisionStage": { "const": "RESPONSE" },
          "systemOutcome": { "const": "COMPLETED" }
        },
        "required": ["decision", "decisionStage", "systemOutcome"]
      },
      "then": {
        "required": ["recordsRead"],
        "properties": { "recordsRead": { "const": 1 } }
      }
    },
    {
      "$comment": "A failed response-stage scan released nothing, so nothing was read out.",
      "if": {
        "properties": {
          "decisionStage": { "const": "RESPONSE" },
          "systemOutcome": { "const": "ERROR" }
        },
        "required": ["decisionStage", "systemOutcome"]
      },
      "then": { "not": { "required": ["recordsRead"] } }
    },
    {
      "$comment": "Scan switch off: the gateway stopped before the policy and before the call (docs/04 §19.1).",
      "if": {
        "properties": { "reasonCodes": { "contains": { "const": "RESPONSE_SCAN_DISABLED" } } },
        "required": ["reasonCodes"]
      },
      "then": {
        "required": ["errorLocation", "downstreamReached"],
        "properties": {
          "systemOutcome": { "const": "ERROR" },
          "errorLocation": { "const": "GATEWAY" },
          "downstreamReached": { "const": false }
        },
        "not": {
          "anyOf": [
            { "required": ["decision"] },
            { "properties": { "decisionStage": { "const": "RESPONSE" } }, "required": ["decisionStage"] },
            { "required": ["latencyMs"] },
            { "required": ["recordsRead"] }
          ]
        }
      }
    },
    {
      "$comment": "A fail-closed outcome never reached the policy; it has no policy input to report.",
      "if": { "not": { "required": ["decision"] } },
      "then": { "properties": { "policyInput": { "type": "null" } } }
    },
    {
      "if": { "required": ["decision"] },
      "then": { "required": ["severity", "riskFlagged"] }
    },
    {
      "if": {
        "properties": { "systemOutcome": { "const": "COMPLETED" } },
        "required": ["systemOutcome"]
      },
      "then": { "required": ["decision"] }
    },
    {
      "if": {
        "properties": { "systemOutcome": { "const": "ERROR" } },
        "required": ["systemOutcome"]
      },
      "then": {
        "required": ["errorLocation", "reasonCodes", "success"],
        "properties": {
          "reasonCodes": { "$ref": "#/$defs/nonEmptyReasonCodes" },
          "responseReleased": { "const": false },
          "success": { "const": false }
        }
      }
    },
    {
      "$comment": "A request-stage BLOCK or APPROVAL never ran the tool: no downstream, no response, no execution measurements.",
      "if": {
        "properties": { "decision": { "enum": ["BLOCK", "APPROVAL"] } },
        "required": ["decision"],
        "not": { "properties": { "decisionStage": { "const": "RESPONSE" } }, "required": ["decisionStage"] }
      },
      "then": {
        "required": ["reasonCodes"],
        "properties": {
          "reasonCodes": { "$ref": "#/$defs/nonEmptyReasonCodes" },
          "downstreamReached": { "const": false },
          "responseReleased": { "const": false }
        },
        "not": {
          "anyOf": [
            { "required": ["success"] },
            { "required": ["recordsRead"] },
            { "required": ["latencyMs"] }
          ]
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": { "decision": { "enum": ["ALLOW", "MASK"] } },
            "required": ["decision"]
          },
          {
            "properties": { "systemOutcome": { "const": "COMPLETED" } },
            "required": ["systemOutcome"]
          }
        ]
      },
      "then": {
        "required": ["success"],
        "properties": {
          "downstreamReached": { "const": true },
          "responseReleased": { "const": true },
          "success": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "responseScan": {
      "$comment": "Response-stage evidence (stage 5): category counts and the detector and response-policy versions only. Never the text, the matched values or their positions. The version patterns keep free text out of the audit record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["detectorVersion", "policyVersion", "counts"],
      "properties": {
        "detectorVersion": { "type": "string", "pattern": "^response-scan-[0-9]{1,4}$" },
        "policyVersion": { "type": "string", "pattern": "^response-policy-[0-9]{1,4}$" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["RRN", "ACCOUNT_NUMBER", "PHONE_NUMBER", "OTHER_CUSTOMER"],
          "properties": {
            "RRN": { "$ref": "#/$defs/findingCount" },
            "ACCOUNT_NUMBER": { "$ref": "#/$defs/findingCount" },
            "PHONE_NUMBER": { "$ref": "#/$defs/findingCount" },
            "OTHER_CUSTOMER": { "$ref": "#/$defs/findingCount" }
          }
        }
      }
    },
    "findingCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "nonEmptyIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "upperSnakeCase": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/upperSnakeCase" }
    },
    "nonEmptyReasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/upperSnakeCase" }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
